{
  "name": "bambu_browser",
  "version": "0.2.2",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "check": "vp check",
    "start": "next start",
    "lint": "vp lint",
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "test": "vp test run && node --test server.node-test.js",
    "validate:bambu-schema": "vp test run lib/bambu/profile-schema.local.test.ts",
    "generate:config-bounds": "node scripts/generate-profile-config-bounds.mjs",
    "generate:orca-config": "node scripts/generate-orca-profile-config.mjs",
    "api": "node server.js",
    "build:electron": "cross-env ELECTRON_STATIC_EXPORT=1 next build",
    "electron:dev": "concurrently -k -n next,electron -c blue,magenta \"next dev\" \"wait-on http://127.0.0.1:3000 && cross-env ELECTRON_DEV=1 electron .\"",
    "electron:preview": "npm run build:electron && electron .",
    "dist": "npm run build:electron && electron-builder --mac --publish never",
    "dist:mac": "npm run dist",
    "dist:win": "npm run build:electron && electron-builder --win --publish never",
    "prepare": "vp config"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@wrksz/themes": "^1.2.0",
    "geist": "^1.7.2",
    "lucide-react": "^1.39.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.19.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.1.0",
    "electron-builder": "^26.15.7",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite-plus": "0.3.0",
    "wait-on": "^9.1.0"
  },
  "allowScripts": {
    "unrs-resolver": true,
    "fsevents": true,
    "electron-winstaller": false
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12.0.2",
      "onFail": "download"
    }
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vitest": "4.1.11"
  }
}
