{
  "name": "bambu_browser",
  "version": "0.2.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run && node --test server.node-test.js",
    "validate:bambu-schema": "vitest run lib/bambu/profile-schema.local.test.ts",
    "generate:config-bounds": "node scripts/generate-profile-config-bounds.mjs",
    "generate:orca-config": "node scripts/generate-orca-profile-config.mjs",
    "api": "node server.js",
    "build:electron": "cross-env ELECTRON_STATIC_EXPORT=1 next build",
    "electron:dev": "concurrently -k -n next,electron -c blue,magenta \"next dev\" \"wait-on http://127.0.0.1:3000 && cross-env ELECTRON_DEV=1 electron .\"",
    "electron:preview": "npm run build:electron && electron .",
    "dist": "npm run build:electron && electron-builder --mac --publish never",
    "dist:mac": "npm run dist",
    "dist:win": "npm run build:electron && electron-builder --win --publish never"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@wrksz/themes": "^1.2.0",
    "geist": "^1.7.2",
    "lucide-react": "^1.37.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "^4.1.11",
    "wait-on": "^9.1.0"
  }
}
